rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict custom claim verification for privileged write access
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('role', '') in ['admin', 'super_admin'];
    }

    function isValidImageUpload(maxSizeMb) {
      return request.resource != null &&
        request.resource.size < maxSizeMb * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Publicly readable product & artisan heritage assets, writable only by verified admins
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId) && isValidImageUpload(5);
    }

    match /artisans/{artisanId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(artisanId) && isValidImageUpload(5);
    }

    match /stories/{storyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(storyId) && isValidImageUpload(8);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
